#!/bin/bash
# ============================================================
#  M3Pro 小车  状态检查 / 远程操作   —— 在 Mac 上运行
#
#    m3pro           查看车辆状态
#    m3pro up        远程启动（代理 + 雷达/TF + 相机）
#    m3pro arm       机械臂回竖直
#    m3pro stop      停雷达 / 相机
#    m3pro sh        直接进入车的 shell
#
#  车的地址默认用 ssh 别名 "car"（见 ~/.ssh/config）
#  想临时换地址:   CAR_HOST=10.24.200.6 m3pro
# ============================================================

CAR="${CAR_HOST:-car}"

# ---------- 透传子命令（需要车上有 ~/car.sh）----------
case "$1" in
  sh)   exec ssh "$CAR" ;;
  up|stop|arm)
        ssh -o ConnectTimeout=8 "$CAR" "bash ~/car.sh $1"
        exit $? ;;
esac

# ---------- 状态检查 ----------
if [ -t 1 ]; then G='\033[32m'; R='\033[31m'; D='\033[2m'; B='\033[1m'; N='\033[0m'
else G=; R=; D=; B=; N=; fi

REMOTE=$(ssh -o ConnectTimeout=8 -o BatchMode=yes "$CAR" bash -s 2>/dev/null << 'EOS'
source /opt/ros/humble/setup.bash 2>/dev/null
[ -f ~/yahboomcar_ws/install/setup.bash ] && source ~/yahboomcar_ws/install/setup.bash
[ -f ~/M3Pro_ws/install/setup.bash ] && source ~/M3Pro_ws/install/setup.bash
echo "@@HOST|$(hostname)|$(hostname -I 2>/dev/null | awk '{print $1}')"
echo "@@UPTIME|$(uptime -p 2>/dev/null | sed 's/^up //')"
echo "@@TOPICS"
ros2 topic list 2>/dev/null
echo "@@ARM"
ros2 topic info /arm6_joints 2>/dev/null | tr '\n' '|'
echo "@@END"
EOS
)

if [ -z "$REMOTE" ]; then
  echo -e "${R}❌ 连不上车 [${CAR}]${N}"
  echo "   · 车电源开了吗？Mac 和车在同一个 WiFi 吗？"
  echo "   · 手动试一次：ssh ${CAR}"
  exit 1
fi

HOSTLINE=$(echo "$REMOTE" | sed -n 's/^@@HOST|//p')
HNAME=$(echo "$HOSTLINE" | cut -d'|' -f1)
HIP=$(echo "$HOSTLINE" | cut -d'|' -f2)
UPTIME_=$(echo "$REMOTE" | sed -n 's/^@@UPTIME|//p')
TOPICS=$(echo "$REMOTE" | awk '/^@@TOPICS$/{f=1;next} /^@@ARM$/{f=0} f')
SUB=$(echo "$REMOTE" | sed -n 's/^@@ARM|//p' | tr '|' '\n' | sed -n 's/.*Subscription count: \([0-9]*\).*/\1/p')

has() { echo "$TOPICS" | grep -qx "$1"; }
st()  { if has "$1"; then printf "${G}%s${N}  " "$1"; else printf "${R}%s${N}  " "$1"; fi; }

echo
echo -e "${B}═══════════ M3Pro 小车 ═══════════${N}"
echo -e "连接      ${G}✅${N} ${CAR} | ${HNAME} (${HIP})"
[ -n "$UPTIME_" ] && echo "已运行    ${UPTIME_}"

echo
echo -n "代理/底层  "
for t in /cmd_vel /odom_raw /imu/data_raw /battery /arm6_joints; do st "$t"; done
echo

echo -n "机械臂     "
if [ "${SUB:-0}" = "1" ]; then
  echo -e "${G}✅${N} 底板已挂上（订阅者 1）"
elif [ -z "$SUB" ] || [ "$SUB" = "0" ]; then
  echo -e "${R}❌${N} 底板没挂上 → 代理没起来，跑 ${B}m3pro up${N}"
fi

echo -n "雷达/TF    "
for t in /scan0 /scan1 /scan_multi /tf /tf_static; do st "$t"; done
echo

echo -n "相机       "
CAM=$(echo "$TOPICS" | grep -iE "camera|rgb|depth" | tr '\n' ' ')
if [ -n "$CAM" ]; then echo -e "${G}✅${N} $CAM"; else echo -e "${R}❌${N} 未启动"; fi

echo
echo -e "${D}提示:  m3pro up 一键启动 · m3pro arm 机械臂竖直 · m3pro sh 进车${N}"
echo -e "${B}════════════════════════════════${N}"
